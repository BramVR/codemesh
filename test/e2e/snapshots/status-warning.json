{
  "case": "status-warning",
  "args": [
    "status",
    "dirty-source",
    "--base",
    "main",
    "--json"
  ],
  "process": {
    "exit_code": 0,
    "exit_class": "readiness-warning"
  },
  "stdout_json": {
    "command": "status",
    "diagnostics": {
      "blockers": [],
      "warnings": []
    },
    "exit_class": "readiness-warning",
    "payload": {
      "project": "dirty-source",
      "projects": [
        {
          "alias": "dirty-source",
          "base": "main",
          "canonical_path": "<FIXTURE_SOURCES>/dirty-source",
          "canonical_path_present": true,
          "diagnostics": {
            "blockers": [],
            "warnings": [
              {
                "code": "dirty-checkout",
                "message": "source checkout has uncommitted or untracked changes"
              }
            ]
          },
          "local_only_paths": [],
          "machine_path": "<FIXTURE_SOURCES>/dirty-source",
          "machine_path_present": true,
          "path": "<FIXTURE_SOURCES>/dirty-source",
          "path_present": true,
          "remote": "<FIXTURE_REMOTES>/dirty-source.git",
          "state": "dirty",
          "workspace_source": "local-only",
          "workspace_state": "hydrated"
        }
      ]
    }
  },
  "stdout_present": true,
  "stderr_present": false
}
